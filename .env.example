# AEGIS environment configuration. Copy to .env (never commit .env).
# Separate values per environment: local / dev / simulation / production.

AEGIS_ENV=local
# SQLite for local work; PostgreSQL/Supabase for permanent simulation:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
AEGIS_DATABASE_URL=sqlite:///var/aegis-local.sqlite

# PAPER_TRADING (default) | SHADOW_TRADING | HISTORICAL_BACKTEST | LIVE_DISABLED (fails closed)
AEGIS_EXECUTION_MODE=PAPER_TRADING

# Research archive (Parquet). Must be a persistent volume: it is the long-term research dataset.
AEGIS_ARCHIVE_DIR=var/archive
# Archive backup destination: a DIFFERENT disk / mounted volume. Required for `aegis maintenance` to prune.
AEGIS_BACKUP_DIR=

# Optional JSON file overriding StrategyConfig (versioned by hash in configuration_versions)
# AEGIS_STRATEGY_FILE=config/strategy.json

AEGIS_LOG_LEVEL=INFO
AEGIS_WORKER_ID=worker-1
AEGIS_CYCLE_INTERVAL_SECONDS=300

# API: bearer token for /control/* endpoints (kill switch). Empty = control endpoints disabled.
AEGIS_API_CONTROL_TOKEN=
AEGIS_API_CORS_ORIGINS=http://localhost:3000

# Optional provider keys (free tiers work without them; paid tiers need owner approval)
AEGIS_COINGECKO_API_KEY=
AEGIS_JUPITER_API_KEY=
AEGIS_HELIUS_API_KEY=
AEGIS_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
AEGIS_HTTP_USER_AGENT=aegis-research/0.2

# NEVER put private keys, seed phrases or wallet secrets here. AEGIS has no signing code.

# Dashboard (web/.env.local)
# NEXT_PUBLIC_AEGIS_API=http://localhost:8000

# Historical research datasets (downloaded with `aegis datasets fetch`; never committed)
AEGIS_DATASETS_DIR=var/datasets
